# =================================================================
# SkyResolve Configuration
# =================================================================

# Choose LLM Provider: deterministic (default offline), openai, anthropic, gemini
LLM_PROVIDER=deterministic

# Model Name (optional, defaults provided per provider)
# LLM_MODEL=gpt-4o
# LLM_MODEL=claude-3-5-sonnet-20241022
# LLM_MODEL=gemini-1.5-flash

# API Key (leave empty for built-in deterministic offline fallback)
LLM_API_KEY=

# Application Port
PORT=8501
