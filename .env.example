# =================================================================
# SkyResolve Configuration
# =================================================================

# Choose LLM Provider: groq, gemini, openai, anthropic, grok, deterministic (default offline)
LLM_PROVIDER=groq

# Model Name (optional, defaults provided per provider)
# LLM_MODEL=openai/gpt-oss-120b
# LLM_MODEL=gpt-4o
# LLM_MODEL=claude-3-5-sonnet-20241022
# LLM_MODEL=gemini-1.5-flash

# API Key (leave empty for built-in deterministic offline fallback)
LLM_API_KEY=your_api_key_here

# Application Port
PORT=8501
